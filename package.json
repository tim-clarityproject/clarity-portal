{
  "name": "clarity-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:panels": "node tests/design-reference/panels-never-jump.mjs",
    "test:typing": "node tests/typing-never-jumps.mjs",
    "test:rules": "node tests/rules/run.mjs",
    "test:scores": "node --import ./tests/scores/register.mjs --test tests/scores/*.test.mjs && node tests/scores/make-db-test.mjs --check && node scripts/make-evidence-seed.mjs --check",
    "test:patterns": "node --test tests/patterns/*.test.mjs",
    "sim:patterns": "node scripts/sim-patterns.mjs",
    "test:scale": "node tests/scale/run.mjs",
    "test:convert": "node --test tests/convert/*.test.mjs",
    "convert:plans": "node scripts/convert-plans/run.mjs",
    "test:healthcheck": "node --test tests/healthcheck/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/noto-emoji": "^5.3.2",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@supabase/supabase-js": "^2.43.0",
    "firebase": "^12.17.1",
    "lucide-react": "^1.32.0",
    "pdfkit": "^0.20.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vercel": "^61.1.0",
    "vite": "^8.2.0"
  }
}
