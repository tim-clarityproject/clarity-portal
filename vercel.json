{
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "functions": {
    "api/guest.js": {
      "includeFiles": "pdf-fonts/**"
    },
    "api/coach.js": {
      "includeFiles": "pdf-fonts/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/billing-nightly",
      "destination": "/api/scheduled?__route=billing-nightly"
    },
    {
      "source": "/api/coach-reminders",
      "destination": "/api/scheduled?__route=coach-reminders"
    },
    {
      "source": "/api/workshop-emails",
      "destination": "/api/scheduled?__route=workshop-emails"
    },
    {
      "source": "/api/coach-billing",
      "destination": "/api/coach?__route=coach-billing"
    },
    {
      "source": "/api/coach-calendar",
      "destination": "/api/coach?__route=coach-calendar"
    },
    {
      "source": "/api/coach-calendar-connect",
      "destination": "/api/coach?__route=coach-calendar-connect"
    },
    {
      "source": "/api/coach-send",
      "destination": "/api/coach?__route=coach-send"
    },
    {
      "source": "/api/coach-invite",
      "destination": "/api/coach?__route=coach-invite"
    },
    {
      "source": "/api/coach-auth-reset",
      "destination": "/api/coach?__route=coach-auth-reset"
    },
    {
      "source": "/api/coach-email-in",
      "destination": "/api/coach?__route=coach-email-in"
    },
    {
      "source": "/api/alignment-email",
      "destination": "/api/guest?__route=alignment-email"
    },
    {
      "source": "/api/booking-email",
      "destination": "/api/guest?__route=booking-email"
    },
    {
      "source": "/api/guest-copy",
      "destination": "/api/guest?__route=guest-copy"
    },
    {
      "source": "/api/agreement-sign",
      "destination": "/api/coach?__route=agreement-sign"
    },
    {
      "source": "/api/agreement-pdf",
      "destination": "/api/coach?__route=agreement-pdf"
    },
    {
      "source": "/api/coach-agreements",
      "destination": "/api/coach?__route=coach-agreements"
    },
    {
      "source": "/api/agreement-settle",
      "destination": "/api/coach?__route=agreement-settle"
    },
    {
      "source": "/api/agreement-link",
      "destination": "/api/guest?__route=agreement-link"
    },
    {
      "source": "/health-check/(.*)",
      "destination": "/health-check.html"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "clarity-portal-app.vercel.app"
        }
      ],
      "destination": "https://portal.theclarityproject.co.uk/:path",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!assets/|api/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/health-check.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "env": {
    "CANONICAL_DOMAIN": "portal.theclarityproject.co.uk"
  }
}
